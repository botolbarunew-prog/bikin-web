---
layout: layouts/base.njk
---
{% from "partials/macros.njk" import kartuProduk, kartuArtikel, breadcrumb, gambar %}
{% set liniObj = collections.lini | find("data.slug", lini) %}
{% set jenisObj = collections.jenis | find("data.slug", jenis) %}
{% set nomor = lini | waFor(site) %}
{% set urlProduk = siteUrl + page.url %}
{% set fotoUtama = foto or (galeri[0] if galeri else "") %}
{% set pesanDasar = "Halo Admin, saya ingin memesan " + title + "." %}
{% set brandObj = {"@type": "Brand", "name": liniObj.data.title} %}

{% set navCrumbs = [
  {"name": "Beranda", "url": "/"},
  {"name": liniObj.data.title, "url": liniObj.url},
  {"name": jenisObj.data.title, "url": jenisObj.url},
  {"name": title, "url": page.url}
] %}

{% set crumbs = [
  {"@type": "ListItem", "position": 1, "name": "Beranda", "item": siteUrl + "/"},
  {"@type": "ListItem", "position": 2, "name": liniObj.data.title, "item": siteUrl + liniObj.url},
  {"@type": "ListItem", "position": 3, "name": jenisObj.data.title, "item": siteUrl + jenisObj.url},
  {"@type": "ListItem", "position": 4, "name": title, "item": urlProduk}
] %}
<script type="application/ld+json">
{{ {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": crumbs} | dump | safe }}
</script>

{# Gambar hanya dicantumkan jika foto asli, bukan placeholder "Foto segera hadir" #}
{% if foto and ("/assets/placeholder/" not in foto) %}
  {% set imageUrl = siteUrl + foto %}
  {% set schemaProduk = {"@context": "https://schema.org", "@type": "Product", "name": title, "description": description, "url": urlProduk, "image": imageUrl, "brand": brandObj} %}
{% else %}
  {% set schemaProduk = {"@context": "https://schema.org", "@type": "Product", "name": title, "description": description, "url": urlProduk, "brand": brandObj} %}
{% endif %}
<script type="application/ld+json">
{{ schemaProduk | dump | safe }}
</script>

{{ breadcrumb(navCrumbs, true) }}

<div class="produk-layout">
  <div class="produk-visual">
    <div class="galeri-produk" data-galeri>
      <div class="slider" data-slider tabindex="0" role="region" aria-roledescription="carousel" aria-label="Foto produk {{ title }}">
        {% for g in varian %}
          {% for o in g.opsi %}
            {% if o.gambar %}
              <figure class="slide" data-src="{{ o.gambar }}">
                <img src="{{ o.gambar }}" alt="{{ title }}, {{ g.nama }} {{ o.nama }}" loading="lazy" width="800" height="800">
              </figure>
            {% endif %}
          {% endfor %}
        {% endfor %}
        {% if fotoUtama %}
          <figure class="slide" data-src="{{ fotoUtama }}">
            <img src="{{ fotoUtama }}" alt="{{ title }}" loading="lazy" width="800" height="800">
          </figure>
        {% endif %}
        {% for g in galeri %}
          <figure class="slide" data-src="{{ g }}">
            <img src="{{ g }}" alt="{{ title }} (foto {{ loop.index }})" loading="lazy" width="800" height="800">
          </figure>
        {% endfor %}
        {% if not fotoUtama and not (galeri and galeri.length) %}
          <figure class="slide">{{ gambar(null, title, spek) }}</figure>
        {% endif %}
      </div>
      <span class="penanda-angka" data-angka aria-live="polite"></span>
      <div class="titik-daftar" data-titik aria-hidden="true"></div>
      <div class="thumbs-wrap">
        <button type="button" class="galeri-panah" data-thumb-panah data-arah="-1" aria-label="Thumbnail sebelumnya">&#8249;</button>
        <div class="thumbs" data-thumbs></div>
        <button type="button" class="galeri-panah" data-thumb-panah data-arah="1" aria-label="Thumbnail berikutnya">&#8250;</button>
      </div>
    </div>

    <dialog class="penuh" data-penuh aria-label="Foto produk {{ title }}">
      <div class="penuh-isi">
        <div class="penuh-area" data-penuh-area>
          <img class="penuh-foto" data-penuh-img alt="" role="button" tabindex="0" aria-label="Perbesar atau kecilkan foto">
        </div>
        <button type="button" class="penuh-tutup" data-penuh-tutup aria-label="Tutup">&times;</button>
        <button type="button" class="penuh-panah kiri" data-penuh-geser="-1" aria-label="Foto sebelumnya">&#8249;</button>
        <button type="button" class="penuh-panah kanan" data-penuh-geser="1" aria-label="Foto berikutnya">&#8250;</button>
        <span class="penuh-angka" data-penuh-angka></span>
      </div>
    </dialog>

    {% if varian and varian.length %}
      <form class="pilihan" id="pilihan-produk" aria-label="Pilihan {{ title }}">
        {% for g in varian %}
          {% set gi = loop.index %}
          <fieldset class="grup-pilihan">
            <legend>{{ g.nama }}</legend>
            <div class="opsi-daftar">
              {% for o in g.opsi %}
                <input class="opsi-input" type="radio" id="g{{ gi }}-o{{ loop.index }}" name="grup-{{ gi }}" value="{{ o.nama }}" data-grup="{{ g.nama }}" data-index="{{ gi }}" data-gambar="{{ o.gambar or '' }}"{% if loop.first %} checked{% endif %}>
                <label class="opsi-label" for="g{{ gi }}-o{{ loop.index }}">{{ o.nama }}</label>
              {% endfor %}
            </div>
          </fieldset>
        {% endfor %}
      </form>
    {% endif %}

    {% if spesifikasi and spesifikasi.length %}
      <h2>Spesifikasi</h2>
      <table class="spec">
        <tbody>
          {% for s in spesifikasi %}
            <tr><th scope="row">{{ s.label }}</th><td>{{ s.nilai }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </div>

  <aside class="order-box" aria-label="Pesan produk">
    <span class="badge">{{ liniObj.data.title }}</span>
    <h1>{{ title }}</h1>
    <p>{{ description }}</p>

    {% if varian and varian.length %}
      <p class="pilihan-terpilih">
        {% for g in varian %}
          <span class="pilihan-item"><span class="pilihan-label">{{ g.nama }}:</span> <strong data-hasil="{{ loop.index }}">{{ g.opsi[0].nama }}</strong></span>{% if not loop.last %}<span class="pilihan-pemisah" aria-hidden="true">&middot;</span>{% endif %}
        {% endfor %}
      </p>
    {% endif %}

    <a class="tombol-wa" id="tombol-pesan" href="https://wa.me/{{ nomor }}?text={{ (pesanDasar + ' Bisa info stok dan harga grosirnya?') | urlencode }}" target="_blank" rel="noopener" data-nomor="{{ nomor }}" data-pesan-dasar="{{ pesanDasar }}">Pesan via WhatsApp</a>

    <ul class="kepercayaan">
      {% for item in site.tepercaya %}
        <li><span aria-hidden="true">&#10003;</span> {{ item }}</li>
      {% endfor %}
    </ul>
    <p class="catatan">Tanpa keranjang. Pesanan diproses langsung di WhatsApp.</p>
  </aside>
</div>

{% if content %}
  <div class="prose">{{ content | safe }}</div>
{% endif %}

<section class="langkah" aria-labelledby="langkah-judul">
  <h2 id="langkah-judul">3 langkah mudah pemesanan</h2>
  <ol class="langkah-list">
    {% for item in site.langkah %}
      <li><span class="langkah-no">0{{ loop.index }}</span><span>{{ item }}</span></li>
    {% endfor %}
  </ol>
</section>

{% set produkSemua = collections.produk | where("data.jenis", jenis) | exclude(page.url) %}
{% set produkSejenis = produkSemua | limit(3) %}
{% set artikelSemua = collections.artikel | whereIncludes("data.jenis", jenis) %}
{% set artikelTerkait = artikelSemua | limit(3) %}

<section class="related">
  <div class="bagian-judul">
    <h2>Produk sejenis</h2>
    {% if produkSemua.length > 3 %}
      <a class="tombol-outline tombol-kecil" href="{{ jenisObj.url }}">Lihat semua</a>
    {% endif %}
  </div>
  {% if produkSejenis.length %}
    <div class="grid">
      {% for p in produkSejenis %}
        {{ kartuProduk(p, liniObj.data.title) }}
      {% endfor %}
    </div>
  {% else %}
    <p class="related-kosong">Belum ada produk sejenis.</p>
  {% endif %}

  <div class="bagian-judul">
    <h2>Artikel terkait</h2>
    {% if artikelSemua.length > 3 %}
      <a class="tombol-outline tombol-kecil" href="/artikel/">Lihat semua</a>
    {% endif %}
  </div>
  {% if artikelTerkait.length %}
    <div class="grid">
      {% for a in artikelTerkait %}
        {{ kartuArtikel(a) }}
      {% endfor %}
    </div>
  {% else %}
    <p class="related-kosong">Belum ada artikel terkait.</p>
  {% endif %}
</section>

<script src="/assets/js/produk.js" defer></script>
