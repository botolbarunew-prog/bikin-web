---
layout: layouts/base.njk
---
{% from "partials/macros.njk" import kartuProduk, kartuArtikel, tombolWa, breadcrumb, gambar as fotoArtikel %}
{% set liniObj = collections.lini | find("data.slug", lini) %}
{% set urlArtikel = siteUrl + page.url %}
{% set penulis = author or site.author %}
{% set peranPenulis = authorRole or site.authorRole %}
{% set nomorArtikel = (lini | waFor(site)) if lini else site.whatsapp_1.number %}
{% set pesanBagikan = title + " " + urlArtikel %}
{% set tanggalTerbit = tanggal | isoDate %}
{% set tanggalUbah = (updatedDate or tanggal) | isoDate %}
{% set publisherObj = {"@type": "Organization", "name": site.nama, "url": siteUrl} %}
{% set penulisObj = {"@type": "Organization", "name": penulis} %}
{% set schemaArtikel = {"@context": "https://schema.org", "@type": "Article", "headline": title, "description": description, "datePublished": tanggalTerbit, "dateModified": tanggalUbah, "mainEntityOfPage": urlArtikel, "author": penulisObj, "publisher": publisherObj} %}
<script type="application/ld+json">
{{ schemaArtikel | dump | safe }}
</script>

{% if lintas %}
  {% set navCrumbs = [
    {"name": "Beranda", "url": "/"},
    {"name": "Artikel", "url": "/artikel/"},
    {"name": title, "url": page.url}
  ] %}
  {% set crumbs = [
    {"@type": "ListItem", "position": 1, "name": "Beranda", "item": siteUrl + "/"},
    {"@type": "ListItem", "position": 2, "name": "Artikel", "item": siteUrl + "/artikel/"},
    {"@type": "ListItem", "position": 3, "name": title, "item": urlArtikel}
  ] %}
{% else %}
  {% set jenisObj = collections.jenis | find("data.slug", jenis[0]) %}
  {% set navCrumbs = [
    {"name": "Beranda", "url": "/"},
    {"name": liniObj.data.title, "url": liniObj.url},
    {"name": jenisObj.data.title, "url": jenisObj.url},
    {"name": title, "url": page.url}
  ] %}
  {% set crumbs = [
    {"@type": "ListItem", "position": 1, "name": "Beranda", "item": siteUrl + "/"},
    {"@type": "ListItem", "position": 2, "name": liniObj.data.title, "item": siteUrl + liniObj.url},
    {"@type": "ListItem", "position": 3, "name": jenisObj.data.title, "item": siteUrl + jenisObj.url},
    {"@type": "ListItem", "position": 4, "name": title, "item": urlArtikel}
  ] %}
{% endif %}
<script type="application/ld+json">
{{ {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": crumbs} | dump | safe }}
</script>

{{ breadcrumb(navCrumbs) }}

<article>
<header class="artikel-head">
  <h1>{{ title }}</h1>
  {% if description %}<p class="lead">{{ description }}</p>{% endif %}

  <div class="byline">
    <div class="penulis">
      <span class="avatar" aria-hidden="true">{{ penulis | initial }}</span>
      <div>
        <p class="penulis-nama">{{ penulis }}</p>
        <p class="penulis-peran">{{ peranPenulis }}</p>
      </div>
    </div>
    <div class="byline-meta">
      <time class="badge-mono" datetime="{{ tanggalTerbit }}">{{ tanggal | readableDate }}</time>
      {% if updatedDate %}
        <time class="badge-mono" datetime="{{ tanggalUbah }}">Diperbarui {{ updatedDate | readableDate }}</time>
      {% endif %}
      <span class="badge-mono">{{ content | readingTime }}</span>
    </div>
    <div class="bagikan">
      <a class="tombol-outline tombol-kecil" href="https://wa.me/?text={{ pesanBagikan | urlencode }}">Bagikan via WhatsApp</a>
      <button type="button" class="tombol-outline tombol-kecil" data-salin="{{ urlArtikel }}">Salin link</button>
    </div>
  </div>
</header>

<figure class="artikel-cover">
  {{ fotoArtikel(foto, title, null) }}
</figure>

<div class="artikel-layout">
  <div class="artikel-main">
    <div class="prose article-content">
      {{ content | safe }}
    </div>

    <aside class="bio" aria-labelledby="bio-judul">
      <h2 id="bio-judul">Tentang penulis</h2>
      <p><strong>{{ penulis }}</strong>. {{ peranPenulis }}.</p>
      <p>Artikel ini ditulis dan ditinjau oleh tim redaksi {{ site.nama }}. Untuk pertanyaan produk, hubungi tim kami langsung melalui WhatsApp.</p>
    </aside>

  </div>

  <aside class="artikel-aside" aria-label="Produk terkait">
    {% if produkTerkait and produkTerkait.length %}
      <div class="sidebar-kotak">
        <h2>Produk terkait yang dibahas</h2>
        {% for p in collections.produk | whereIn("data.slug", produkTerkait) %}
          {{ kartuProduk(p, liniObj.data.title) }}
        {% endfor %}
      </div>
    {% endif %}

    <div class="sidebar-kotak nudge">
      <p>Masih ragu memilih? Tanyakan langsung kebutuhan Anda ke tim kami.</p>
      {{ tombolWa(nomorArtikel, "Halo, saya habis membaca artikel " + title + " dan ingin bertanya.", "Tanya via WhatsApp") }}
    </div>
  </aside>
</div>
</article>

{% set artikelSerupa = collections.artikel | whereIncludes("data.jenis", jenis[0]) | exclude(page.url) %}
{% if artikelSerupa.length %}
<section class="related">
  <div class="bagian-judul">
    <h2>Artikel terkait</h2>
    {% if artikelSerupa.length > 3 %}
      <a class="tombol-outline tombol-kecil" href="/artikel/">Lihat semua</a>
    {% endif %}
  </div>
  <div class="grid">
    {% for a in artikelSerupa | limit(3) %}
      {{ kartuArtikel(a) }}
    {% endfor %}
  </div>
</section>
{% endif %}

<script>
  document.querySelectorAll('[data-salin]').forEach(function (b) {
    b.addEventListener('click', function () {
      try {
        navigator.clipboard.writeText(b.dataset.salin);
        b.textContent = 'Tersalin';
      } catch (e) {
        b.textContent = 'Gagal menyalin';
      }
    });
  });
</script>
