---
layout: layouts/base.njk
---
{% from "partials/macros.njk" import tombolWa %}

<h1>{{ title }}</h1>
{{ content | safe }}

{% if status == "aktif" %}
  <h2>Jenis produk</h2>
  {% for j in collections.jenis | where("data.lini", slug) %}
    <article>
      <h3><a href="{{ j.url }}">{{ j.data.title }}</a></h3>
      <p>{{ j.data.description }}</p>
    </article>
  {% endfor %}
{% else %}
  <p>Lini ini segera hadir.</p>
{% endif %}

{{ tombolWa(wa, pesanWa, "Hubungi via WA") }}
