{% set liniSlugSekarang = lini or slug %}
{% set liniObj = collections.lini | find("data.slug", liniSlugSekarang) %}
{% set nomorHalaman = liniSlugSekarang | waFor(site) %}
{% set pesanHalaman = liniObj.data.pesanWa or site.pesanDefault %}
<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="google-site-verification" content="Gkn0Qw0VXGUSlyVJXQKajrr9X06KSeUQh5G7ycBI58U">
  <meta name="google-site-verification" content="YC7Xj8ztNaq1_S70V1GbIjKWcJVchpZdfljttF7wOTE">
  <title>{{ title }} | {{ site.nama }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="canonical" href="{{ siteUrl }}{{ page.url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/assets/css/style.css">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.nama }}",
    "url": "{{ siteUrl }}/",
    "description": "{{ site.tagline }}",
    "email": "{{ site.email }}",
    "address": {"@type": "PostalAddress", "streetAddress": "{{ site.address }}", "addressCountry": "ID"},
    "contactPoint": [
      {"@type": "ContactPoint", "telephone": "+{{ site.whatsapp_1.number }}", "contactType": "customer service", "areaServed": "ID", "availableLanguage": "Indonesian"},
      {"@type": "ContactPoint", "telephone": "+{{ site.whatsapp_2.number }}", "contactType": "customer service", "areaServed": "ID", "availableLanguage": "Indonesian"}
    ]
  }
  </script>
</head>
<body>
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href="/">{{ site.nama }}</a>

      <input type="checkbox" id="menu-toggle" class="menu-check">
      <label for="menu-toggle" class="menu-btn">Menu</label>

      <nav class="site-nav" aria-label="Menu utama">
        <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Beranda</a>

        <details class="dropdown">
          <summary>Unit Bisnis</summary>
          <div class="dropdown-panel">
            {% for g in site.divisi %}
              <p class="grup-label">{{ g.nama }}</p>
              <ul>
                {% for slug in g.units %}
                  {% set l = collections.lini | find("data.slug", slug) %}
                  {% if l %}
                    <li><a href="{{ l.url }}"{% if page.url == l.url %} aria-current="page"{% endif %}>{{ l.data.title }}</a></li>
                  {% endif %}
                {% endfor %}
              </ul>
            {% endfor %}
          </div>
        </details>

        <a href="/katalog/"{% if page.url == "/katalog/" %} aria-current="page"{% endif %}>Katalog Produk</a>
        <a href="/artikel/"{% if page.url == "/artikel/" %} aria-current="page"{% endif %}>Artikel &amp; Panduan</a>
        <a href="/tentang-kami/"{% if page.url == "/tentang-kami/" %} aria-current="page"{% endif %}>Tentang Kami</a>
        <a class="btn-header" href="https://wa.me/{{ site.whatsapp_1.number }}?text={{ site.pesanDefault | urlencode }}" target="_blank" rel="noopener">Hubungi Kami</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <p class="footer-brand">{{ site.nama }}</p>
        <p class="footer-muted">{{ site.tagline }}</p>
        <p class="footer-muted">{{ site.address }}</p>
        <p class="footer-muted">{{ site.email }}</p>
      </div>

      <div>
        <h2 class="footer-judul">Unit Bisnis</h2>
        <ul class="footer-list">
          {% for l in collections.lini %}
            <li><a href="{{ l.url }}">{{ l.data.title }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div>
        <h2 class="footer-judul">Kategori &amp; Informasi</h2>
        <ul class="footer-list">
          {% for j in collections.jenis %}
            <li><a href="{{ j.url }}">{{ j.data.title }}</a></li>
          {% endfor %}
          <li><a href="/tentang-kami/">Tentang Kami</a></li>
          <li><a href="/artikel/">Artikel</a></li>
          <li><a href="/syarat/">Syarat &amp; Ketentuan</a></li>
          <li><a href="/kebijakan-privasi/">Kebijakan Privasi</a></li>
        </ul>
      </div>

      <div>
        <h2 class="footer-judul">Layanan WhatsApp</h2>
        <a class="kartu-cs" href="https://wa.me/{{ site.whatsapp_1.number }}?text={{ site.pesanDefault | urlencode }}" target="_blank" rel="noopener">
          <span class="cs-label">{{ site.whatsapp_1.label }}</span>
          <span class="cs-role">{{ site.whatsapp_1.role }}</span>
          <span class="spek">{{ site.whatsapp_1.display }}</span>
        </a>
        <a class="kartu-cs" href="https://wa.me/{{ site.whatsapp_2.number }}?text={{ site.pesanDefault | urlencode }}" target="_blank" rel="noopener">
          <span class="cs-label">{{ site.whatsapp_2.label }}</span>
          <span class="cs-role">{{ site.whatsapp_2.role }}</span>
          <span class="spek">{{ site.whatsapp_2.display }}</span>
        </a>
      </div>
    </div>
    <div class="wrap footer-bawah">
      <p>&copy; {{ year }} {{ site.nama }}. Semua hak dilindungi.</p>
    </div>
  </footer>

  <a class="wa-float" href="https://wa.me/{{ nomorHalaman }}?text={{ pesanHalaman | urlencode }}" target="_blank" rel="noopener" aria-label="Chat CS Resmi via WhatsApp (dibuka di tab baru)">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.6 1.1 2.8.1.2 1.8 2.8 4.4 3.9 2.6 1 2.6.7 3.1.7a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .1-1.2c-.1-.1-.3-.2-.5-.3z"/>
    </svg>
    <span>Chat CS Resmi</span>
  </a>
  <script src="/assets/js/gambar.js" defer></script>
</body>
</html>
