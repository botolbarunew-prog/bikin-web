---
layout: layouts/base.njk
---
{% from "partials/macros.njk" import kartu %}
{% set liniObj = collections.lini | find("data.slug", lini) %}

{% set crumbs = [
  {"@type": "ListItem", "position": 1, "name": "Beranda", "item": siteUrl + "/"},
  {"@type": "ListItem", "position": 2, "name": liniObj.data.title, "item": siteUrl + liniObj.url},
  {"@type": "ListItem", "position": 3, "name": title, "item": siteUrl + page.url}
] %}
<script type="application/ld+json">
{{ {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": crumbs} | dump | safe }}
</script>

<nav>
  <a href="/{{ lini }}/">{{ liniObj.data.title }}</a>
</nav>

<h1>{{ title }}</h1>
{{ content | safe }}

<h2>Produk</h2>
{% for p in collections.produk | where("data.jenis", slug) %}
  {{ kartu(p) }}
{% endfor %}

<h2>Artikel</h2>
{% for a in collections.artikel | whereIncludes("data.jenis", slug) %}
  {{ kartu(a) }}
{% endfor %}
