---
layout: layouts/base.njk
---
{% from "partials/macros.njk" import kartuProduk, kartuArtikel, breadcrumb %}
{% set liniObj = collections.lini | find("data.slug", lini) %}

{% set navCrumbs = [
  {"name": "Beranda", "url": "/"},
  {"name": liniObj.data.title, "url": liniObj.url},
  {"name": title, "url": page.url}
] %}

{% set crumbs = [
  {"@type": "ListItem", "position": 1, "name": "Beranda", "item": siteUrl + "/"},
  {"@type": "ListItem", "position": 2, "name": liniObj.data.title, "item": siteUrl + liniObj.url},
  {"@type": "ListItem", "position": 3, "name": title, "item": siteUrl + page.url}
] %}
<script type="application/ld+json">
{{ {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": crumbs} | dump | safe }}
</script>

{{ breadcrumb(navCrumbs) }}

<h1>{{ title }}</h1>
{% if description %}<p class="lead">{{ description }}</p>{% endif %}
{{ content | safe }}

<section>
  <h2>Produk</h2>
  <div class="grid">
    {% for p in collections.produk | where("data.jenis", slug) %}
      {{ kartuProduk(p, liniObj.data.title) }}
    {% endfor %}
  </div>
</section>

{% set artikelJenis = collections.artikel | whereIncludes("data.jenis", slug) %}
{% if artikelJenis.length %}
<section>
  <h2>Artikel</h2>
  <div class="grid">
    {% for a in artikelJenis %}
      {{ kartuArtikel(a) }}
    {% endfor %}
  </div>
</section>
{% endif %}
