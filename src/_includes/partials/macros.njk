{# Tombol utama ke WhatsApp. Satu per area agar fokus pada aksi utama. #}
{% macro tombolWa(nomor, pesan, label) -%}
<a class="tombol-wa" href="https://wa.me/{{ nomor }}?text={{ pesan | urlencode }}" target="_blank" rel="noopener">{{ label }}</a>
{%- endmacro %}

{# Breadcrumb visual. Item terakhir ditandai aria-current.
   ringkas = true (dipakai di produk dan artikel): di ponsel, item di atas induk diganti titik-tiga,
   sehingga yang tampil "… > Induk > Halaman ini". Di desktop jalur lengkap tetap tampil. #}
{% macro breadcrumb(items, ringkas) -%}
<nav class="breadcrumb{% if ringkas %} breadcrumb-ringkas{% endif %}" aria-label="Breadcrumb">
  <ol>
    {% for it in items %}
      {% if ringkas and loop.first and items.length > 2 %}<li class="bc-elipsis" aria-hidden="true">&hellip;</li>{% endif %}
      <li class="{% if ringkas and loop.revindex > 2 %}bc-jauh{% endif %}" title="{{ it.name }}">{% if loop.last %}<span aria-current="page">{{ it.name }}</span>{% else %}<a href="{{ it.url }}">{{ it.name }}</a>{% endif %}</li>
    {% endfor %}
  </ol>
</nav>
{%- endmacro %}

{# Gambar dengan fallback. Jika belum ada foto, tampil placeholder teknis (ikon garis navy dan label mono). #}
{% macro gambar(src, alt, label) -%}
{% if src %}
<img src="{{ src }}" alt="{{ alt }}" loading="lazy" decoding="async" width="800" height="800">
{% else %}
<div class="placeholder" role="img" aria-label="{{ alt or 'Foto belum tersedia' }}">
  <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <rect x="10" y="14" width="44" height="36" rx="3" fill="none" stroke="#0A192F" stroke-width="3"/>
    <circle cx="24" cy="27" r="4" fill="none" stroke="#0A192F" stroke-width="3"/>
    <path d="M14 46l13-13 8 8 6-6 9 11" fill="none" stroke="#0A192F" stroke-width="3" stroke-linejoin="round"/>
  </svg>
  {% if label %}<span class="badge-mono">{{ label }}</span>{% endif %}
</div>
{% endif %}
{%- endmacro %}

{# Kartu produk: tepat 4 elemen (visual, badge lini, judul + panah, spesifikasi kunci). Tanpa tombol WA. #}
{% macro kartuProduk(p, liniTitle) -%}
<a class="kartu-produk" href="{{ p.url }}">
  <div class="foto">
    {{ gambar(p.data.foto, p.data.title, p.data.spek) }}
  </div>
  <div class="isi">
    <span class="badge">{{ liniTitle }}</span>
    <h3>{{ p.data.title }}</h3>
    {% if p.data.spek %}<span class="badge-mono">{{ p.data.spek }}</span>{% endif %}
  </div>
</a>
{%- endmacro %}

{# Kartu lini untuk beranda. #}
{% macro kartuLini(l) -%}
<a class="kartu-lini" href="{{ l.url }}">
  <div class="foto">
    {{ gambar(l.data.gambar, l.data.title, null) }}
  </div>
  <div class="isi">
    {% if l.data.status == "aktif" %}
      <span class="badge">Tersedia</span>
    {% else %}
      <span class="badge badge-outline">Segera hadir</span>
    {% endif %}
    <h3>{{ l.data.title }}</h3>
    <p>{{ l.data.description }}</p>
  </div>
</a>
{%- endmacro %}

{# Kartu jenis produk di halaman lini. #}
{% macro kartuJenis(j) -%}
<a class="kartu-teks" href="{{ j.url }}">
  <div class="isi">
    <h3>{{ j.data.title }} <span class="panah" aria-hidden="true">&rarr;</span></h3>
    <p>{{ j.data.description }}</p>
  </div>
</a>
{%- endmacro %}

{# Kartu artikel: tanggal, judul, ringkasan. #}
{% macro kartuArtikel(a) -%}
<a class="kartu-artikel" href="{{ a.url }}">
  <div class="foto">
    {{ gambar(a.data.foto, a.data.title, null) }}
  </div>
  <time class="meta" datetime="{{ a.data.tanggal | isoDate }}">{{ a.data.tanggal | readableDate }}</time>
  <h3>{{ a.data.title }}</h3>
  <p>{{ a.data.description }}</p>
</a>
{%- endmacro %}
{# Form layanan pembeli. penuh = false: di footer, tertutup dan dibuka di tempat. penuh = true: di beranda, semua isian terlihat. #}
{% macro formPembeli(penuh) -%}
<form class="form-pembeli{% if penuh %} form-penuh{% endif %}" data-form-pembeli data-pesan-awal="Halo Admin, saya" novalidate>
  {% if not penuh %}<div class="form-isi" id="form-isi" hidden>{% endif %}
  <div class="form-baris combo" data-combo>
    <label for="fp-produk">Produk</label>
    <input id="fp-produk" name="produk" type="text" role="combobox" aria-expanded="false" aria-controls="daftar-produk" aria-autocomplete="list" aria-describedby="fp-pesan" autocomplete="off" placeholder="Ketik atau pilih produk">
    <ul id="daftar-produk" class="combo-daftar" role="listbox" hidden>
      {% for j in collections.jenis %}
        {% set produkJenis = collections.produk | where("data.jenis", j.data.slug) %}
        {% if produkJenis.length %}
          <li role="option" id="opsi-{{ j.data.slug }}" data-nomor="{{ produkJenis[0].data.lini | waFor(site) }}">{{ j.data.title }}</li>
        {% endif %}
      {% endfor %}
    </ul>
    <p class="form-pesan" id="fp-pesan" role="alert" hidden>Pilih produk dari daftar.</p>
  </div>
  {% if penuh %}
    <div class="form-baris">
      <label for="fp-nama">Nama <span class="form-opsional">(opsional)</span></label>
      <input id="fp-nama" name="nama" type="text" autocomplete="name" maxlength="60">
    </div>
    <div class="form-baris">
      <label for="fp-catatan">Catatan <span class="form-opsional">(opsional)</span></label>
      <textarea id="fp-catatan" name="catatan" rows="3" maxlength="300"></textarea>
    </div>
  {% else %}
    <div class="isian-tambahan" data-isian>
      <div class="isian-baris">
        <label class="isian-judul" for="fp-nama">Nama <span class="form-opsional">(opsional)</span></label>
        <button type="button" class="isian-ikon" data-ikon aria-expanded="false" aria-controls="isi-nama" aria-label="Tambah nama">
          <svg class="ikon-tambah" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="ikon-kurang" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="ikon-hapus" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <div class="isian-isi" id="isi-nama" hidden>
        <input id="fp-nama" name="nama" type="text" autocomplete="name" maxlength="60">
      </div>
    </div>

    <div class="isian-tambahan" data-isian>
      <div class="isian-baris">
        <label class="isian-judul" for="fp-catatan">Catatan <span class="form-opsional">(opsional)</span></label>
        <button type="button" class="isian-ikon" data-ikon aria-expanded="false" aria-controls="isi-catatan" aria-label="Tambah catatan">
          <svg class="ikon-tambah" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="ikon-kurang" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="ikon-hapus" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <div class="isian-isi" id="isi-catatan" hidden>
        <textarea id="fp-catatan" name="catatan" rows="2" maxlength="300"></textarea>
      </div>
    </div>
  {% endif %}
  {% if not penuh %}</div>{% endif %}

  {% if penuh %}
    <button type="submit" class="tombol-wa tombol-form">Kirim ke WhatsApp</button>
  {% else %}
    <button type="submit" class="tombol-wa tombol-form" aria-expanded="false" aria-controls="form-isi">Buka form</button>
  {% endif %}
</form>
{%- endmacro %}

{# Kartu lini untuk pratinjau yang berjalan di beranda. Tidak bisa diklik, hanya tampilan. #}
{% macro kartuLiniPratinjau(l) -%}
<div class="lini-kartu">
  <div class="foto">{{ gambar(l.data.gambar, l.data.title, null) }}</div>
  <h3>{{ l.data.title }}</h3>
  <p>{{ l.data.description }}</p>
</div>
{%- endmacro %}
