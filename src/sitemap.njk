---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for p in collections.all %}{% set jumlahProduk = 1 %}{% if p.inputPath and ("/jenis/" in p.inputPath) %}{% set jumlahProduk = (collections.produk | where("data.jenis", p.data.slug)).length %}{% endif %}{% if p.url and p.url != "/admin/" and p.url != "/404.html" and jumlahProduk %}
  <url><loc>{{ siteUrl }}{{ p.url }}</loc></url>
{% endif %}{% endfor %}
</urlset>
