---
layout: layouts/base.njk
title: Grosir Botol Plastik dan Kemasan
description: Grosir botol plastik, toples, cup, dan kantong dari Laju Official. Pilih produk di katalog, lalu pesan langsung lewat WhatsApp. Jas hujan & topi, Gizi Prima, dan Digital Marketing segera hadir.
permalink: /
---
{% from "partials/macros.njk" import tombolWa, kartuLiniPratinjau, kartuArtikel, kartuProduk, gambar, formPembeli with context %}

<div class="hero-pita">
<section class="hero hero-grid">
  <div class="hero-teks">
    <p class="eyebrow">{{ site.nama }}</p>
    <h1>Produk pilihan untuk kebutuhan usaha Anda</h1>
    <p class="hero-lead">Pilih produk di katalog, lalu lanjutkan pemesanan langsung lewat WhatsApp. Tanpa keranjang, tanpa ribet.</p>
    <div class="hero-aksi">
      <a class="tombol-wa" href="#produk-cari">Lihat produk</a>
      <a class="tombol-outline" href="https://wa.me/{{ site.whatsapp_1.number }}?text={{ site.pesanDefault | urlencode }}" target="_blank" rel="noopener">Tanya via WA</a>
    </div>
  </div>
  <figure class="hero-visual">
    <div class="cf" data-cover-flow>
      <div class="cf-jalur">
        {% for l in collections.lini | limit(4) %}
          <a class="cf-kartu" href="{{ l.url }}" data-cf-kartu>
            <div class="foto">{{ gambar(l.data.gambar, l.data.title, null) }}</div>
            <span class="cf-judul">{{ l.data.title }}</span>
          </a>
        {% endfor %}
      </div>
      <div class="cf-titik" role="group" aria-label="Pilih lini">
        {% for l in collections.lini | limit(4) %}
          <button type="button" data-cf-titik="{{ loop.index0 }}" aria-label="{{ l.data.title }}"></button>
        {% endfor %}
      </div>
    </div>
  </figure>
</section>
</div>

<section id="produk" class="produk-beranda judul-tengah">
  <h2>Temukan produk yang sesuai kebutuhan usaha Anda.</h2>

  <div class="produk-cari" data-cari id="produk-cari">
    <button type="button" class="cari-tombol" aria-label="Buka pencarian" aria-expanded="false" aria-controls="cari-beranda">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <span class="cari-ketik" data-cari-ketik aria-hidden="true">Coba cari sesuatu...</span>
    <label class="sr-saja" for="cari-beranda">Cari produk</label>
    <input id="cari-beranda" type="search" placeholder="Cari produk, misalnya botol atau toples" autocomplete="off">
    <button type="button" class="cari-hapus" aria-label="Hapus teks pencarian" hidden>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>

  <div class="filter-baris">
    <div class="filter-track" role="group" aria-label="Jenis produk">
      <button type="button" class="filter-chip" data-jenis="" aria-pressed="true">Semua</button>
      {% for j in collections.jenis %}
        {% set produkJenis = collections.produk | where("data.jenis", j.data.slug) %}
        {% if produkJenis.length %}
          <button type="button" class="filter-chip" data-jenis="{{ j.data.slug }}" aria-pressed="false">{{ j.data.title }}</button>
        {% endif %}
      {% endfor %}
    </div>
    <button type="button" class="filter-lainnya" aria-expanded="false" aria-label="Lihat semua jenis" hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <div class="grid" data-produk>
    {% for p in collections.produk %}
      {% set liniProduk = collections.lini | find("data.slug", p.data.lini) %}
      <div class="produk-item" data-jenis="{{ p.data.jenis }}" data-teks="{{ (p.data.title + ' ' + (p.data.spek or '') + ' ' + liniProduk.data.title) | lower }}">
        {{ kartuProduk(p, liniProduk.data.title) }}
      </div>
    {% endfor %}
  </div>

  <p class="produk-kosong" data-kosong hidden>Produk yang Anda cari belum ada. Coba kata lain, atau tanyakan langsung kepada kami lewat WhatsApp.</p>
</section>

<section class="langkah judul-tengah" aria-labelledby="langkah-judul">
  <h2 id="langkah-judul">Pesan dalam tiga langkah.</h2>
  <ol class="langkah-list">
    {% for item in site.langkah %}
      <li><span class="langkah-no">0{{ loop.index }}</span><span>{{ item }}</span></li>
    {% endfor %}
  </ol>
</section>

<section id="lini" class="lini-bagian judul-tengah">
  <h2>Satu payung untuk beberapa lini usaha.</h2>
  <p class="lead">Setiap lini punya produk dan cara pemesanannya sendiri.</p>
  <div class="lini-berjalan">
    <div class="lini-jalur">
      {% for l in collections.lini %}
        {{ kartuLiniPratinjau(l) }}
      {% endfor %}
      <div class="lini-salinan" aria-hidden="true">
        {% for l in collections.lini %}
          {{ kartuLiniPratinjau(l) }}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% set artikelTerbaru = collections.artikel | limit(3) %}
{% if artikelTerbaru.length %}
<section class="judul-tengah">
  <h2>Panduan untuk memilih <span class="kata-ganti" data-kata-ganti style="background: #E8EEF9; color: #1E3A8A;">kemasan</span> yang tepat.</h2>
  <div class="artikel-wadah">
    <div class="grid artikel-geser" data-geser>
      {% for a in artikelTerbaru %}
        {{ kartuArtikel(a) }}
      {% endfor %}
      <a class="artikel-lihat artikel-lihat-hp" href="/artikel/" aria-label="Lihat semua artikel">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <div class="artikel-titik" role="group" aria-label="Pilih artikel">
      {% for a in artikelTerbaru %}
        <button type="button" aria-label="Artikel {{ loop.index }}"></button>
      {% endfor %}
    </div>
    <div class="artikel-lihat-bawah">
      <a class="artikel-lihat" href="/artikel/" aria-label="Lihat semua artikel">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>
{% endif %}

<section class="layanan-penuh" id="layanan-pembeli" aria-labelledby="layanan-pembeli-judul">
  <div class="layanan-kolom">
    <div class="layanan-kiri">
      <h2 id="layanan-pembeli-judul">Tanyakan stok, harga grosir, atau pemesanan produk.</h2>
      <p class="lead">Tim kami akan membantu Anda.</p>
    </div>
    <div class="layanan-kanan">
      {{ formPembeli(true) }}
    </div>
  </div>
</section>

<script>
  (function () {
    // Pencarian dan filter jenis produk di beranda. Daftar tampil maksimal 3 produk.
    var BATAS = 3;
    var cari = document.getElementById('cari-beranda');

    // Contoh di kolom cari dipilih dari yang paling lengkap yang masih muat di lebar kolom. Teksnya tidak pernah terpotong
    var contohCari = ['Cari produk, misalnya botol atau toples', 'Cari produk, misalnya botol', 'Cari produk'];
    var ukurTeks = document.createElement('canvas').getContext('2d');
    function aturContohCari() {
      // Kolom input tertutup saat belum dibuka, jadi lebarnya diukur dari kotak pencarian: dikurangi tombol ikon dan jaraknya
      var gaya = window.getComputedStyle(cari);
      var tersedia = cari.closest('.produk-cari').clientWidth - 44 - 8 - parseFloat(gaya.paddingRight) - 8;
      ukurTeks.font = gaya.fontWeight + ' ' + gaya.fontSize + ' ' + gaya.fontFamily;
      var pilihan = contohCari.find(function (teks) { return ukurTeks.measureText(teks).width <= tersedia; }) || contohCari[contohCari.length - 1];
      cari.placeholder = pilihan;
    }
    aturContohCari();
    window.addEventListener('resize', aturContohCari);
    if (document.fonts) document.fonts.ready.then(aturContohCari);

    var chips = document.querySelectorAll('.filter-chip');
    var items = document.querySelectorAll('[data-produk] .produk-item');
    var kosong = document.querySelector('[data-kosong]');
    var track = document.querySelector('.filter-track');
    var lainnya = document.querySelector('.filter-lainnya');
    var jenisAktif = '';

    function pilih(chip) {
      jenisAktif = chip.getAttribute('data-jenis');
      chips.forEach(function (c) { c.setAttribute('aria-pressed', String(c === chip)); });
      segarkan();
    }

    function segarkan() {
      var kata = cari.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      var n = 0;
      items.forEach(function (el) {
        var cocokJenis = !jenisAktif || el.getAttribute('data-jenis') === jenisAktif;
        var cocokKata = kata.every(function (k) { return el.getAttribute('data-teks').indexOf(k) !== -1; });
        var cocok = cocokJenis && cocokKata;
        if (cocok) n++;
        el.hidden = !cocok || n > BATAS;
      });
      kosong.hidden = n !== 0;
    }

    cari.addEventListener('input', segarkan);

    // Kolom cari: awalnya hanya ikon dengan teks "Coba cari..." yang mengetik dan menghapus berulang.
    // Ikon atau teksnya diklik: kolom terbuka dengan animasi. Di mode tanpa animasi, teksnya diam.
    var wadahCari = document.querySelector('[data-cari]');
    var tombolCari = wadahCari.querySelector('.cari-tombol');
    var ketikCari = wadahCari.querySelector('[data-cari-ketik]');
    var gerakCari = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var kataCari = 'Coba cari sesuatu...';
    var jumlahHuruf = 0;
    var arahKetik = 1;
    var jedaKetik = null;

    function langkahKetik() {
      if (wadahCari.classList.contains('terbuka')) return;
      jumlahHuruf += arahKetik;
      ketikCari.textContent = kataCari.slice(0, jumlahHuruf);
      var tunggu = 110;
      if (jumlahHuruf === kataCari.length) { arahKetik = -1; tunggu = 1400; }
      else if (jumlahHuruf === 0) { arahKetik = 1; tunggu = 500; }
      else if (arahKetik === -1) { tunggu = 60; }
      jedaKetik = setTimeout(langkahKetik, tunggu);
    }

    function mulaiKetik() {
      clearTimeout(jedaKetik);
      if (!gerakCari) { ketikCari.textContent = kataCari; return; }
      jumlahHuruf = 0;
      arahKetik = 1;
      langkahKetik();
    }

    function bukaCari() {
      if (wadahCari.classList.contains('terbuka')) return;
      clearTimeout(jedaKetik);
      wadahCari.classList.add('terbuka');
      tombolCari.setAttribute('aria-expanded', 'true');
      cari.focus();
    }

    function tutupCari() {
      if (cari.value !== '' || document.activeElement === cari) return;
      wadahCari.classList.remove('terbuka');
      tombolCari.setAttribute('aria-expanded', 'false');
      mulaiKetik();
    }

    // Tombol X: muncul saat kolom berisi teks, dan menghapus teksnya
    var tombolHapus = wadahCari.querySelector('.cari-hapus');
    function segarHapus() {
      tombolHapus.hidden = !(wadahCari.classList.contains('terbuka') && cari.value !== '');
    }
    tombolHapus.addEventListener('click', function (e) {
      e.stopPropagation();
      cari.value = '';
      cari.dispatchEvent(new Event('input'));
      cari.focus();
      segarHapus();
    });
    cari.addEventListener('input', segarHapus);

    wadahCari.addEventListener('click', bukaCari);

    // Tombol "Lihat produk" di hero: kolom cari langsung terbuka dan siap diketik
    var linkCari = document.querySelector('a[href="#produk-cari"]');
    if (linkCari) linkCari.addEventListener('click', function () { setTimeout(bukaCari, 300); });
    cari.addEventListener('blur', function () { setTimeout(function () { tutupCari(); segarHapus(); }, 150); });
    mulaiKetik();

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () { pilih(chip); });
    });

    // Tertutup: chip yang turun ke baris kedua disembunyikan. Tombol ikon muncul hanya jika ada yang disembunyikan.
    function cekBaris() {
      var buka = track.classList.contains('terbuka');
      var awal = chips[0].offsetTop;
      var adaBarisKedua = false;
      chips.forEach(function (c) {
        var turun = c.offsetTop > awal;
        if (turun) adaBarisKedua = true;
        c.classList.toggle('sembunyi', !buka && turun);
      });
      lainnya.hidden = !adaBarisKedua;
    }

    lainnya.addEventListener('click', function () {
      var buka = track.classList.toggle('terbuka');
      lainnya.classList.toggle('terbuka', buka);
      lainnya.setAttribute('aria-expanded', String(buka));
      lainnya.setAttribute('aria-label', buka ? 'Tutup daftar jenis' : 'Lihat semua jenis');
      cekBaris();
      // Jika jenis yang dipilih ikut tersembunyi, kembali ke "Semua" agar yang tampil sesuai dengan yang dipilih
      var aktif = track.querySelector('[aria-pressed="true"]');
      if (!buka && aktif.classList.contains('sembunyi')) pilih(chips[0]);
    });

    window.addEventListener('resize', cekBaris);
    cekBaris();
    segarkan();

    // Artikel di HP: titik penanda mengikuti kartu yang terlihat, dan titik bisa diklik
    var geserArtikel = document.querySelector('[data-geser]');
    if (geserArtikel) {
      var kartuArtikel = geserArtikel.querySelectorAll('.kartu-artikel');
      var titikArtikel = document.querySelectorAll('.artikel-titik button');
      function tandaiTitik() {
        var awal = geserArtikel.getBoundingClientRect().left + 16;
        var dekat = 0;
        var jarakTerkecil = Infinity;
        kartuArtikel.forEach(function (c, i) {
          var jarak = Math.abs(c.getBoundingClientRect().left - awal);
          if (jarak < jarakTerkecil) { jarakTerkecil = jarak; dekat = i; }
        });
        titikArtikel.forEach(function (b, i) { b.setAttribute('aria-current', String(i === dekat)); });
      }
      geserArtikel.addEventListener('scroll', tandaiTitik, { passive: true });
      titikArtikel.forEach(function (b, i) {
        b.addEventListener('click', function () {
          kartuArtikel[i].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        });
      });
      tandaiTitik();
    }

    // Lebar halaman tanpa scroll bar, dipakai pita navy hero supaya tepi kiri dan kanannya pas
    function aturLebarHalaman() {
      document.documentElement.style.setProperty('--lebar-halaman', document.documentElement.clientWidth + 'px');
    }
    aturLebarHalaman();
    window.addEventListener('resize', aturLebarHalaman);

    // Kolom cari di beranda selebar judul di atasnya (baris terpanjang, termasuk saat judul turun baris)
    var judulProduk = document.querySelector('.produk-beranda > h2');
    var kolomCari = document.querySelector('.produk-beranda .produk-cari');
    function aturLebarCari() {
      if (!judulProduk || !kolomCari) return;
      var rentang = document.createRange();
      rentang.selectNodeContents(judulProduk);
      kolomCari.style.width = rentang.getBoundingClientRect().width + 'px';
    }
    aturLebarCari();
    window.addEventListener('resize', aturLebarCari);
    if (document.fonts) document.fonts.ready.then(aturLebarCari);

    // Judul artikel: satu kata berganti sesuai lini (kata dan warnanya mengikuti warna lini). Tidak berganti jika gerak dikurangi.
    var kataGanti = document.querySelector('[data-kata-ganti]');
    if (kataGanti && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var daftarKata = [
        { kata: 'kemasan', latar: '#E8EEF9', teks: '#1E3A8A' },
        { kata: 'supplier', latar: '#FBE9E9', teks: '#CB0000' },
        { kata: 'proteksi', latar: '#E6F4F2', teks: '#0F766E' },
        { kata: 'pemasaran', latar: '#EAEEF4', teks: '#112240' }
      ];
      var posisiKata = 0;
      setInterval(function () {
        // Kata langsung berganti. Latar ikut melebar atau menyempit mengikuti panjang kata baru, tanpa fade
        var lebarLama = kataGanti.getBoundingClientRect().width;
        posisiKata = (posisiKata + 1) % daftarKata.length;
        var k = daftarKata[posisiKata];
        kataGanti.textContent = k.kata;
        kataGanti.style.background = k.latar;
        kataGanti.style.color = k.teks;
        kataGanti.style.width = 'auto';
        var lebarBaru = kataGanti.getBoundingClientRect().width;
        kataGanti.style.width = lebarLama + 'px';
        kataGanti.offsetWidth;
        kataGanti.style.width = lebarBaru + 'px';
        setTimeout(function () { kataGanti.style.width = ''; }, 500);
      }, 2500);
    }

    // Kartu langkah: muncul satu per satu saat masuk layar, dan memudar lagi saat keluar. Tanpa animasi jika sistem meminta gerakan dikurangi
    var langkahList = document.querySelector('.langkah-list');
    if (langkahList && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      langkahList.classList.add('siap-muncul');
      new IntersectionObserver(function (entri) {
        langkahList.classList.toggle('muncul', entri[0].isIntersecting);
      }, { threshold: 0.3 }).observe(langkahList);
    }

    // Form layanan: naik dari bawah saat digulir ke sana, dan turun lagi saat digulir ke atas. Berlaku sekali per arah, tidak mengikuti posisi scroll.
    // Tidak turun saat pengunjung sedang mengisi form. Di mode tanpa animasi, form langsung tampil.
    var layanan = document.querySelector('.layanan-penuh');
    if (layanan && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      layanan.classList.add('siap-muncul');
      var sedangIsi = function () {
        return layanan.contains(document.activeElement) ||
          Array.prototype.some.call(layanan.querySelectorAll('input, textarea, select'), function (f) { return f.value !== ''; });
      };
      new IntersectionObserver(function (entri) {
        entri.forEach(function (e) {
          if (e.isIntersecting) { layanan.classList.add('muncul'); return; }
          // Turun hanya kalau bagian ini ada di bawah layar (pengunjung menggulir ke atas)
          if (e.boundingClientRect.top > 0 && !sedangIsi()) layanan.classList.remove('muncul');
        });
      }, { threshold: 0.5 }).observe(layanan);
    }

    // Cover flow lini di hero: kartu aktif di tengah, berputar otomatis (kecuali pengguna yang mengatur gerak dikurangi).
    // Berhenti saat disentuh atau fokus. Bisa digeser dengan jari, diklik titiknya, atau pakai panah kiri-kanan.
    var cover = document.querySelector('[data-cover-flow]');
    if (cover) {
      var kartuCover = cover.querySelectorAll('[data-cf-kartu]');
      var titikCover = cover.querySelectorAll('[data-cf-titik]');
      var jumlah = kartuCover.length;
      var aktifCover = 0;
      var timerCover = null;
      var geserBaru = false;
      var mulaiX = null;
      var gerakKurang = window.matchMedia('(prefers-reduced-motion: reduce)');

      // Jarak tiap kartu dari kartu aktif, dihitung melingkar supaya bisa berputar terus
      function susunCover() {
        kartuCover.forEach(function (k, i) {
          var d = ((i - aktifCover) % jumlah + jumlah) % jumlah;
          if (d > jumlah / 2) d -= jumlah;
          k.style.setProperty('--d', d);
          k.style.setProperty('--abs', Math.abs(d));
          // Posisi dan putaran dihitung langsung di sini, bukan lewat variabel CSS
          k.style.transform = 'translateX(calc(-50% + ' + (d * 55) + '%)) rotateY(' + (-d * 40) + 'deg) scale(' + (1 - Math.abs(d) * 0.12) + ')';
          k.classList.toggle('cf-jauh', Math.abs(d) > 1);
          k.tabIndex = i === aktifCover ? 0 : -1;
        });
        titikCover.forEach(function (t, i) {
          t.setAttribute('aria-current', String(i === aktifCover));
        });
      }

      function pilihCover(i) {
        aktifCover = (i + jumlah) % jumlah;
        susunCover();
      }

      function jalanCover() {
        if (gerakKurang.matches || timerCover) return;
        timerCover = setInterval(function () { pilihCover(aktifCover + 1); }, 4000);
      }

      function henti() {
        clearInterval(timerCover);
        timerCover = null;
      }

      kartuCover.forEach(function (k, i) {
        k.addEventListener('click', function (e) {
          if (geserBaru) { e.preventDefault(); geserBaru = false; return; }
          // Kartu samping diklik: pindah ke kartu itu dulu. Kartu yang sudah di tengah membuka halaman lininya.
          if (i !== aktifCover) { e.preventDefault(); pilihCover(i); }
        });
      });

      titikCover.forEach(function (t, i) {
        t.addEventListener('click', function () { pilihCover(i); });
      });

      cover.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') pilihCover(aktifCover + 1);
        if (e.key === 'ArrowLeft') pilihCover(aktifCover - 1);
      });

      cover.addEventListener('pointerdown', function (e) {
        if (e.pointerType === 'touch' || e.pointerType === 'pen') mulaiX = e.clientX;
        henti();
      });

      cover.addEventListener('pointerup', function (e) {
        if (mulaiX !== null) {
          var dx = e.clientX - mulaiX;
          if (Math.abs(dx) > 40) {
            pilihCover(aktifCover + (dx < 0 ? 1 : -1));
            geserBaru = true;
          }
          mulaiX = null;
        }
        // Dengan mouse, putaran tetap berhenti selama kursor di atas hero (lihat mouseleave)
        if (e.pointerType !== 'mouse') jalanCover();
      });

      cover.addEventListener('mouseenter', henti);
      cover.addEventListener('mouseleave', jalanCover);
      cover.addEventListener('focusin', henti);
      cover.addEventListener('focusout', jalanCover);

      susunCover();
      jalanCover();
    }

    // Lini kami: kursor di atas kartu menjeda (lewat CSS). Di HP, jari yang menekan kartu menjeda sampai diangkat.
    var jalurLini = document.querySelector('.lini-berjalan');
    var bagianLini = document.querySelector('.lini-bagian');
    jalurLini.addEventListener('pointerdown', function (e) {
      if (e.pointerType === 'touch') bagianLini.classList.add('jeda');
    });
    ['pointerup', 'pointercancel'].forEach(function (nama) {
      document.addEventListener(nama, function () { bagianLini.classList.remove('jeda'); });
    });

    // Mode gerak dikurangi: kartu digeser manual. Karena ada dua salinan, saat sampai ujung kiri atau kanan posisinya dipindah ke sisi lain, jadi terus berputar
    jalurLini.addEventListener('scroll', function () {
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var setengah = jalurLini.scrollWidth / 2;
      if (jalurLini.scrollLeft >= setengah) jalurLini.scrollLeft -= setengah;
      else if (jalurLini.scrollLeft <= 0) jalurLini.scrollLeft += setengah;
    }, { passive: true });

    // Mode gerak dikurangi di desktop: kartu bisa diseret dengan mouse (scroll bar disembunyikan)
    var seretLini = null;
    var sudahSeret = false;
    jalurLini.addEventListener('pointerdown', function (e) {
      if (e.pointerType !== 'mouse' || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      seretLini = e.clientX;
      sudahSeret = false;
    });
    window.addEventListener('pointermove', function (e) {
      if (seretLini === null) return;
      var dx = e.clientX - seretLini;
      if (Math.abs(dx) > 4) sudahSeret = true;
      jalurLini.scrollLeft -= dx;
      seretLini = e.clientX;
    });
    window.addEventListener('pointerup', function () { seretLini = null; });
    window.addEventListener('dragstart', function (e) { if (seretLini !== null) e.preventDefault(); });
    // Setelah diseret, lepasnya tidak dianggap klik ke halaman lini
    jalurLini.addEventListener('click', function (e) {
      if (sudahSeret) { e.preventDefault(); sudahSeret = false; }
    }, true);
  })();
</script>
